<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island"
        Width="600" Height="260"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- Modern Button Style for Media Controls -->
        <Style x:Key="MediaControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#11FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- The Dynamic Island Capsule -->
        <Border x:Name="IslandCapsule"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,10,0,0"
                Width="180" Height="36"
                CornerRadius="18"
                Background="#FF0B0B0B"
                BorderBrush="#2AFFFFFF"
                BorderThickness="1"
                MouseEnter="IslandCapsule_MouseEnter"
                MouseLeave="IslandCapsule_MouseLeave"
                Cursor="Hand"
                ClipToBounds="True">

            <!-- Depth DropShadow -->
            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                                  ShadowDepth="4"
                                  Opacity="0.5"
                                  Color="#000000"/>
            </Border.Effect>

            <Grid>
                <!-- Compact / Idle View -->
                <Grid x:Name="CompactContent" Opacity="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Live Indicator Dot -->
                    <Ellipse x:Name="LiveIndicatorDot" Grid.Column="0" Width="9" Height="9"
                             Fill="#1DB954" Margin="14,0,8,0" VerticalAlignment="Center"/>

                    <!-- Current Song or Idle Title -->
                    <TextBlock x:Name="CompactTrackText" Grid.Column="1" Text="Dynamic Island"
                               Foreground="#EEEEEE" FontSize="12"
                               FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- Mini Music Symbol -->
                    <TextBlock x:Name="CompactStatusIcon" Grid.Column="2" Text="♫"
                               Foreground="#1DB954" FontSize="13"
                               Margin="8,0,14,0" VerticalAlignment="Center"/>
                </Grid>

                <!-- Expanded View (Rich Media Player Widget) -->
                <Grid x:Name="ExpandedContent" Opacity="0" IsHitTestVisible="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Status Bar -->
                    <DockPanel Grid.Row="0" Margin="16,12,16,6">
                        <TextBlock x:Name="SourceAppText" Text="Now Playing" 
                                   Foreground="#888888" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="TimelineText" Text="--:-- / --:--" 
                                   Foreground="#888888" FontSize="11"
                                   HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                    </DockPanel>

                    <!-- Main Player Body -->
                    <Grid Grid.Row="1" Margin="16,0,16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Album Art Thumbnail with Rounded Corners -->
                        <Border Grid.Column="0" Width="52" Height="52"
                                CornerRadius="12" Background="#1E1E1E"
                                BorderBrush="#20FFFFFF" BorderThickness="1"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                ClipToBounds="True">
                            <Grid>
                                <TextBlock x:Name="AlbumArtPlaceholder" Text="🎵" FontSize="22" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="AlbumArtImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <!-- Track Info, Progress, and Controls -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <!-- Song Title -->
                            <TextBlock x:Name="ExpandedTrackTitle" Text="Not Playing" 
                                       Foreground="White" FontWeight="Bold" FontSize="13" 
                                       TextTrimming="CharacterEllipsis"/>

                            <!-- Artist -->
                            <TextBlock x:Name="ExpandedArtist" Text="Play media on Spotify or Chrome" 
                                       Foreground="#AAAAAA" FontSize="11" Margin="0,1,0,6"
                                       TextTrimming="CharacterEllipsis"/>

                            <!-- Progress Bar -->
                            <ProgressBar x:Name="PlaybackProgressBar" Height="3" Value="0" Maximum="100"
                                         Foreground="#1DB954" Background="#282828" BorderThickness="0"/>

                            <!-- Media Control Buttons -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <Button x:Name="PrevButton" Style="{StaticResource MediaControlButtonStyle}" 
                                        Content="⏮" FontSize="11" Click="PrevButton_Click" ToolTip="Previous Track"/>

                                <Button x:Name="PlayPauseButton" Style="{StaticResource MediaControlButtonStyle}" 
                                        Content="▶" FontSize="13" Margin="16,0,16,0" Click="PlayPauseButton_Click" ToolTip="Play / Pause"/>

                                <Button x:Name="NextButton" Style="{StaticResource MediaControlButtonStyle}" 
                                        Content="⏭" FontSize="11" Click="NextButton_Click" ToolTip="Next Track"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
